# ==============================================================
# Occasions Web Application - Environment Configuration Template
# Copy this file to .env.local and fill in the appropriate values.
# NEVER commit .env.local or secret keys into source control!
# ==============================================================

# Application & Database Configuration
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"

# JWT Authentication
JWT_SECRET="your-jwt-secret-key-at-least-32-chars-long"

# Google OAuth Authentication
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# ==============================================================
# Module 1: Firebase Authentication (Client & Server Admin SDK)
# ==============================================================
# Firebase Client SDK Configuration (Firebase Console > Project Settings > General > Your Apps)
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourFirebaseWebApiKeyHere"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-app-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-app-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-app-id.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789:web:abcdef123456"

# Firebase Admin SDK Configuration (Firebase Console > Project Settings > Service Accounts)
# Option A: Full JSON Service Account string or Base64 encoded string:
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# Option B: Individual Service Account credentials:
FIREBASE_PROJECT_ID="your-app-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-app-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASC...\n-----END PRIVATE KEY-----"

# ==============================================================
# Module 2: Razorpay Payment Gateway (Test Sandbox / Production)
# ==============================================================
# Razorpay API Credentials (Razorpay Dashboard > Settings > API Keys)
# In Test mode, keys begin with 'rzp_test_'. In Live mode, keys begin with 'rzp_live_'.
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YourTestKeyIdHere"
RAZORPAY_KEY_ID="rzp_test_YourTestKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpaySecretKeyHere"

# Razorpay Webhook Secret (Razorpay Dashboard > Settings > Webhooks > Secret)
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_key"

# ==============================================================
# SMS & Cloudinary Media
# ==============================================================
# Fast2SMS (Free India SMS Gateway - https://www.fast2sms.com)
FAST2SMS_API_KEY="your-fast2sms-api-authorization-key"

# Cloudinary CDN Image Uploads
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"

# ==============================================================
# Email Notifications (Contact Form Inquiries)
# ==============================================================
EMAIL_USER="occassions.flowers@gmail.com"
EMAIL_PASS="your-16-character-gmail-app-password"
OWNER_EMAIL="occassions.flowers@gmail.com"

# ==============================================================
# Module: Meta WhatsApp Cloud API & Webhooks
# Documentation: developers.facebook.com > WhatsApp > Configuration
# Callback URL: https://occassion.vercel.app/api/webhooks/whatsapp
# ==============================================================
# 1. Custom string token for Meta Webhook verification handshake (must match Meta Dashboard)
WHATSAPP_VERIFY_TOKEN="your_custom_webhook_verification_token"

# 2. Meta WhatsApp Cloud API Access Token (System User Permanent Token recommended)
WHATSAPP_ACCESS_TOKEN="your_meta_system_user_or_permanent_access_token"

# 3. WhatsApp Phone Number ID (from WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID="your_meta_phone_number_id"

# 4. WhatsApp Business Account ID (WABA ID from WhatsApp > API Setup)
WHATSAPP_BUSINESS_ACCOUNT_ID="your_meta_whatsapp_business_account_id"

# 5. Meta App Secret for HMAC-SHA256 webhook signature verification (App Settings > Basic > App Secret)
META_APP_SECRET="your_meta_app_secret_32_hex_chars"

# Optional Cloud API Settings
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_OWNER_PHONE="919447446008"
# Optional approved Meta utility template name (fallback to formatted text message if left blank)
WHATSAPP_ORDER_TEMPLATE_NAME="order_confirmation"
WHATSAPP_TEMPLATE_LANG="en"
